# Gemini Enterprise Agent Platform (GEAP) / Google Cloud Vertex AI
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global

# Optional: Application Default Credentials path if not using standard `gcloud auth application-default login`
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Model Name
MODEL_NAME=gemini-3.8-flash

# Location for model calls (independent of GOOGLE_CLOUD_LOCATION; gemini-3.8-flash is only on global)
MODEL_LOCATION=global

# Optional: A2A agent card URL of the AI news agent (sreekarun/ai-news-agent).
# When set, the chatbot hands AI-news questions to it. Leave unset to disable.
# NEWS_AGENT_CARD_URL=https://us-east4-aiplatform.googleapis.com/reasoningEngines/v1/projects/<project>/locations/us-east4/reasoningEngines/<id>/api/a2a/ai_news_agent/.well-known/agent-card.json
